// ergon defaults for fastfetch; ~/.config/fastfetch/config.jsonc takes precedence.
// The logo is rendered from the emblem by branding/generate.py.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/ergon/fastfetch-logo.txt",
    "width": 28,
    "height": 16,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;216;112;76", "title": "38;2;216;112;76" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "format": "{pretty-name}" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "display",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
